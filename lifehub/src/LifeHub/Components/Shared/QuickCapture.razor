@inject AskService Ask

@* The "Ask" / "Add" pop-up from the top bar and the phone's + button. *@
<Modal Open="Open" OpenChanged="OpenChanged" Title="@(Ask.IsAvailable ? "Ask LifeHub" : "Add something")">
    <ChildContent>
        @if (Open)
        {
            <AskPanel OnDone="() => OpenChanged.InvokeAsync(false)" />
        }
    </ChildContent>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
}
