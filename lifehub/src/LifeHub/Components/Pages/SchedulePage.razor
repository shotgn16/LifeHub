@page "/schedule"
@inherits LiveComponent
@inject ScheduleService Schedule
@inject PlannerService Planner
@inject CalendarService Calendar
@inject TaskService Tasks
@inject SettingsService Settings
@inject Clock Clock
@inject UiState Ui
@inject AutomationService Automation

<PageTitle>Schedule · LifeHub</PageTitle>

<div class="page-head">
    <div>
        <h1>Schedule</h1>
        <div class="sub">@date.ToString("dddd d MMMM yyyy", Fmt.Culture)@(dayOff ? " · day off" : "")</div>
    </div>
    <div class="actions">
        <button class="icon-btn" @onclick="() => Go(-1)" title="Previous day"><Icon Name="left" /></button>
        <button class="btn sm" @onclick="() => GoTo(Clock.Today)">Today</button>
        <button class="icon-btn" @onclick="() => Go(1)" title="Next day"><Icon Name="right" /></button>
        <input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="DatePicked" style="width:auto" />
        <button class="btn primary" @onclick="() => planOpen = true"><Icon Name="plus" Size="15" /> <span>Time off or plans</span></button>
    </div>
</div>

<PlanEditor @bind-Open="planOpen" Date="date" Saved="PlansChanged" />

<div class="tabs">
    <button class="tab @(tab == "day" ? "on" : "")" @onclick='() => tab = "day"'>Day</button>
    <button class="tab @(tab == "week" ? "on" : "")" @onclick="OpenWeek">Week</button>
    <button class="tab @(tab == "template" ? "on" : "")" @onclick='() => tab = "template"'>My usual week</button>
</div>

@if (tab == "day")
{
    <div class="grid cols-3">
        <div class="card span-2">
            <div class="card-head">
                <h2><Icon Name="clock" /> Timeline</h2>
                <div class="right">
                    <button class="btn sm" @onclick="Reload"><Icon Name="refresh" Size="14" /></button>
                </div>
            </div>
            @if (loading) { <p class="muted">Loading calendar…</p> }
            @if (dayPlans.Count > 0) { <div class="tiny muted" style="margin:0 0 4px 72px">Added for this day</div> }
            @foreach (var p in dayPlans)
            {
                <div class="tl-item plan-row k-@PlanCss(p.Kind)" style="margin-left:72px">
                    <span><strong>@p.Name</strong> <span class="tiny muted">@(p.AllDay ? "all day" : $"{p.Start:HH:mm}–{p.End:HH:mm}") · @SchedulePlan.KindName(p.Kind).ToLower()</span></span>
                    <button class="icon-btn right" title="Remove" @onclick="() => RemovePlan(p)"><Icon Name="x" Size="14" /></button>
                </div>
            }
            @foreach (var e in events.Where(e => e.AllDay))
            {
                <div class="tl-item event" style="margin-left:72px">All day · <strong>@e.Title</strong> <span class="tiny muted">@e.Source</span></div>
            }
            <div class="timeline">
                @foreach (var item in Timeline())
                {
                    <div class="tl-row">
                        <div class="tl-time">@item.Start.ToString("HH:mm")</div>
                        <div class="tl-item @item.Css @(item.IsNow ? "now" : "")">
                            <div style="display:flex;gap:8px;align-items:center">
                                <strong>@item.Title</strong>
                                <span class="tiny muted right">@item.Start.ToString("HH:mm")–@item.End.ToString("HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Meta)) { <div class="tiny muted">@item.Meta</div> }
                        </div>
                    </div>
                }
            </div>
            @if (Calendar.LastErrors.Count > 0)
            {
                <div class="alert warn small">@string.Join("; ", Calendar.LastErrors)</div>
            }
            <p class="tiny muted" style="margin-top:8px">
                <span class="badge info">Work</span> <span class="badge ok">Free</span> time comes from your usual week; <span class="badge">out / kept free</span>
                from time off and plans you've added; <span class="badge warn">events</span> from your calendars; <span class="badge accent">tasks</span> planned by you or "Plan my day".
            </p>
        </div>

        <div class="card">
            <div class="card-head"><h2><Icon Name="wand" /> Plan this day</h2></div>
            <p class="small muted">Slots open tasks into free gaps: @string.Join(", ", Settings.Current.Schedule.CategoryPeriods.Select(kv => $"{kv.Key} → {kv.Value}")) and everything else into Free time. Overdue and high-priority first.</p>
            <button class="btn primary" style="width:100%" @onclick="Propose" disabled="@busy"><Icon Name="wand" Size="15" /> @(plan is null ? "Suggest a plan" : "Re-plan")</button>
            @if (plan is not null)
            {
                <ul class="list" style="margin-top:12px">
                    @if (plan.Planned.Count == 0) { <li class="empty small">Nothing to plan — or no free gaps left.</li> }
                    @foreach (var p in plan.Planned)
                    {
                        <li class="row">
                            <span class="small nowrap muted">@p.Start.ToString("HH:mm")</span>
                            <div class="grow"><div class="title small">@p.Title</div><div class="meta">@p.Category · @((int)(p.End - p.Start).TotalMinutes) min</div></div>
                            <button class="icon-btn" title="Skip" @onclick="() => plan.Planned.Remove(p)"><Icon Name="x" Size="14" /></button>
                        </li>
                    }
                </ul>
                @if (plan.Unplanned.Count > 0)
                {
                    <div class="alert warn small" style="margin-top:10px">Didn't fit today: @string.Join(", ", plan.Unplanned.Select(t => t.Title))</div>
                }
                @if (plan.Planned.Count > 0)
                {
                    @if (Calendar.CanCreateEvents)
                    {
                        <label class="check" style="margin-top:10px"><input type="checkbox" @bind="addToCalendar" /> Also add as calendar events</label>
                    }
                    <button class="btn primary" style="width:100%" @onclick="Apply" disabled="@busy"><Icon Name="check" Size="15" /> Apply plan</button>
                }
            }
            @if (scheduledToday.Count > 0)
            {
                <hr />
                <h3 style="margin-bottom:6px">Already planned</h3>
                <ul class="list">
                    @foreach (var t in scheduledToday)
                    {
                        <li class="row">
                            <span class="small nowrap muted">@t.ScheduledStart!.Value.ToString("HH:mm")</span>
                            <div class="grow small">@t.Title</div>
                            <button class="icon-btn" title="Unplan" @onclick="() => Unplan(t)"><Icon Name="x" Size="14" /></button>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
else if (tab == "week")
{
    <div class="week-head">
        <button class="icon-btn" @onclick="() => MoveWeek(-7)" title="Previous week"><Icon Name="left" /></button>
        <strong>@weekStart.ToString("d MMM", Fmt.Culture) – @weekStart.AddDays(6).ToString("d MMM yyyy", Fmt.Culture)</strong>
        <button class="icon-btn" @onclick="() => MoveWeek(7)" title="Next week"><Icon Name="right" /></button>
    </div>
    <div class="week-grid">
        @foreach (var d in week)
        {
            <div class="week-day @(d.Date == Clock.Today ? "today" : "") @(d.DayOff ? "off" : "")">
                <button class="week-day-head" @onclick="() => OpenDay(d.Date)" title="Open this day">
                    <span>@d.Date.ToString("ddd", Fmt.Culture)</span> <strong>@d.Date.Day</strong>
                </button>
                <div class="week-sum">@d.Summary</div>
                @foreach (var i in d.Items)
                {
                    <div class="week-item k-@i.Css" title="@i.Title">
                        <span class="tiny muted">@i.When</span><span class="week-title">@i.Title</span>
                    </div>
                }
                @if (d.Items.Count == 0) { <div class="tiny muted">Nothing booked</div> }
            </div>
        }
    </div>
    @if (loading) { <p class="muted">Loading calendars…</p> }

    <div class="card" style="margin-top:16px">
        <div class="card-head">
            <h2><Icon Name="calendar" /> Time off and plans</h2>
            <div class="right"><button class="btn sm" @onclick="() => planOpen = true"><Icon Name="plus" Size="14" /> Add</button></div>
        </div>
        <p class="small muted">Holidays, time out, time you're keeping free and extra work — they don't need to be in a calendar.
            You can also just tell LifeHub, e.g. <em>"I'm out Thursday 2 till 4"</em>.</p>
        <ul class="list">
            @if (upcoming.Count == 0) { <li class="empty small">Nothing coming up.</li> }
            @foreach (var p in upcoming)
            {
                <li class="row">
                    <span class="badge @PlanBadge(p.Kind)">@SchedulePlan.KindName(p.Kind)</span>
                    <div class="grow"><div class="title">@p.Name</div><div class="meta">@p.When(Fmt.Culture)</div></div>
                    <button class="icon-btn" title="Remove" @onclick="() => RemovePlan(p)"><Icon Name="trash" Size="15" /></button>
                </li>
            }
        </ul>
    </div>
}
else
{
    @if (!usualExact && !advanced)
    {
        <div class="alert info small"><Icon Name="alert" /> <div>Your week was set up in detail. These simpler settings are LifeHub's best guess — saving them replaces the detailed periods.
            <a href="" @onclick:preventDefault @onclick="() => advanced = true">Keep editing in detail</a></div></div>
    }
    @if (!advanced)
    {
        <div class="grid cols-2">
            <div class="card">
                <h2 style="margin-bottom:4px">When I work</h2>
                <p class="small muted" style="margin-top:0">Tick the days you work and your hours. Work tasks are planned into work time.</p>
                <ul class="list usual-days">
                    @foreach (var d in usual.Days)
                    {
                        <li class="row">
                            <Toggle Value="d.Working" ValueChanged="v => d.Working = v" />
                            <div class="usual-day">@d.Day.ToString()</div>
                            @if (d.Working)
                            {
                                <div class="usual-hours">
                                    <input type="time" @bind="d.WorkStart" aria-label="@($"{d.Day} start")" />
                                    <span class="muted">–</span>
                                    <input type="time" @bind="d.WorkEnd" aria-label="@($"{d.Day} finish")" />
                                </div>
                            }
                            else { <span class="small muted">Not working</span> }
                        </li>
                    }
                </ul>
                <button class="btn sm" @onclick="CopyFirstWorkDay" style="margin-top:8px">Use @FirstWorkDayName's hours on every work day</button>
            </div>

            <div class="card">
                <h2 style="margin-bottom:4px">My day</h2>
                <p class="small muted" style="margin-top:0">When you're up and about. Nothing gets planned outside these times.</p>
                <div class="usual-span">
                    <span>On days I work</span>
                    <div class="usual-hours"><input type="time" @bind="usual.WorkDayFrom" aria-label="Day starts on work days" /> <span class="muted">to</span>
                    <input type="time" @bind="usual.WorkDayTo" aria-label="Day ends on work days" /></div>
                </div>
                <div class="usual-span">
                    <span>On days off</span>
                    <div class="usual-hours"><input type="time" @bind="usual.OffDayFrom" aria-label="Day starts on days off" /> <span class="muted">to</span>
                    <input type="time" @bind="usual.OffDayTo" aria-label="Day ends on days off" /></div>
                </div>

                <h3 style="margin:18px 0 4px">Regular times to keep free</h3>
                <p class="small muted" style="margin-top:0">Things you do every week, like the gym or the school run.</p>
                <ul class="list">
                    @foreach (var r in usual.Regular)
                    {
                        <li class="regular">
                            <input type="text" @bind="r.Label" placeholder="e.g. Gym" maxlength="40" aria-label="What it's for" />
                            <div class="chips">
                                @foreach (var d in UsualWeek.Order)
                                {
                                    <button class="chip @(r.Days.Contains(d) ? "on" : "")" style="padding:3px 8px" @onclick="() => ToggleDay(r.Days, d)">@d.ToString()[..2]</button>
                                }
                            </div>
                            <div class="regular-times">
                                <input type="time" @bind="r.Start" aria-label="From" /> <span class="muted">–</span> <input type="time" @bind="r.End" aria-label="To" />
                                <button class="icon-btn" title="Remove" @onclick="() => usual.Regular.Remove(r)"><Icon Name="trash" Size="15" /></button>
                            </div>
                        </li>
                    }
                </ul>
                <button class="btn sm" @onclick="AddRegular"><Icon Name="plus" Size="14" /> Add a regular time</button>
            </div>
        </div>
    }
    else
    {
        <div class="card" style="margin-bottom:16px">
            <div class="card-head">
                <h2>Periods in detail</h2>
                <div class="right">
                    <button class="btn sm" @onclick="AddBlock"><Icon Name="plus" Size="14" /> Add period</button>
                </div>
            </div>
            <p class="small muted">Every period of your usual week. Calendar events always win; an all-day event containing a day-off word turns that day's work periods into free time.</p>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Days</th><th>From</th><th>To</th><th>Type</th><th>Label</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in blocks)
                        {
                            <tr>
                                <td>
                                    <div class="chips">
                                        @foreach (var d in UsualWeek.Order)
                                        {
                                            <button class="chip @(b.Days.Contains(d) ? "on" : "")" style="padding:3px 8px" @onclick="() => { ToggleDay(b.Days, d); blocksEdited = true; }">@d.ToString()[..2]</button>
                                        }
                                    </div>
                                </td>
                                <td><input type="time" @bind="b.Start" @bind:after="Edited" style="width:auto" /></td>
                                <td><input type="time" @bind="b.End" @bind:after="Edited" style="width:auto" /></td>
                                <td><select @bind="b.Kind" @bind:after="Edited" style="width:auto">@foreach (var k in Enum.GetValues<PeriodKind>()) { <option value="@k">@KindLabel(k)</option> }</select></td>
                                <td><input type="text" @bind="b.Label" @bind:after="Edited" /></td>
                                <td><button class="icon-btn" @onclick="() => { blocks.Remove(b); blocksEdited = true; }"><Icon Name="trash" Size="15" /></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <p class="small" style="margin:12px 0 16px">
        @if (advanced) { <a href="" @onclick:preventDefault @onclick="BackToSimple">Back to the simple settings</a> }
        else { <a href="" @onclick:preventDefault @onclick="() => advanced = true">Edit every period in detail</a> }
    </p>

    <div class="grid cols-3">
        <div class="card">
            <h2 style="margin-bottom:10px">Which tasks go where</h2>
            @foreach (var c in Settings.Current.General.TaskCategories)
            {
                <div class="row">
                    <div class="grow">@c</div>
                    <select style="width:auto" value="@(categoryMap.TryGetValue(c, out var k) ? k.ToString() : "Free")" @onchange="e => categoryMap[c] = Enum.Parse<PeriodKind>(e.Value!.ToString()!)">
                        <option value="Free">Free time</option>
                        <option value="Work">Work time</option>
                        <option value="Focus">Focus time</option>
                    </select>
                </div>
            }
        </div>
        <div class="card">
            <h2 style="margin-bottom:10px">Automatic planning</h2>
            <label class="check"><input type="checkbox" @bind="autoEvening" /> Plan tomorrow every evening at</label>
            <input type="time" @bind="autoEveningTime" style="width:auto;margin:-4px 0 12px 26px" />
            <label class="check"><input type="checkbox" @bind="autoMorning" /> Fit in anything new each morning at</label>
            <input type="time" @bind="autoMorningTime" style="width:auto;margin:-4px 0 12px 26px" />
            <div class="form-grid">
                <div class="field"><label>Max tasks planned per day</label><input type="number" min="1" max="30" @bind="autoMax" /></div>
                <div class="field" style="display:flex;align-items:flex-end"><label class="check"><input type="checkbox" @bind="autoCalendar" /> Also add them to my calendar</label></div>
            </div>
            <p class="small muted">Only tasks without a time are planned, overdue and high priority first; you get a notification with the plan. Anything you plan by hand is left alone.</p>
            <button class="btn sm" @onclick="RunAutoPlanNow"><Icon Name="wand" Size="14" /> Run for tomorrow now</button>
            @if (!string.IsNullOrEmpty(Automation.LastAutoPlan)) { <p class="tiny muted" style="margin-top:8px">Last run: @Automation.LastAutoPlan</p> }
        </div>
        <div class="card">
            <h2 style="margin-bottom:10px">Planning</h2>
            <div class="field"><label>Day-off words</label><input type="text" @bind="dayOffWords" /><div class="help">An all-day calendar event with one of these words (comma separated) counts as a day off.</div></div>
            <div class="form-grid">
                <div class="field"><label>Default task length (min)</label><input type="number" min="5" @bind="defaultMinutes" /></div>
                <div class="field"><label>Gap between items (min)</label><input type="number" min="0" @bind="bufferMinutes" /></div>
            </div>
        </div>
    </div>
    <div style="margin-top:16px;display:flex;gap:8px">
        <button class="btn primary" @onclick="SaveTemplate">Save</button>
        <button class="btn" @onclick="ResetTemplate">Reset to defaults</button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private string tab = "day";
    private DateOnly date;
    private List<SchedulePlan> dayPlans = new(), upcoming = new();
    private bool planOpen;

    // Week view
    private DateOnly weekStart;
    private record WeekItem(string When, string Title, string Css);
    private record WeekDay(DateOnly Date, string Summary, bool DayOff, List<WeekItem> Items);
    private List<WeekDay> week = new();

    // Usual week
    private UsualWeek usual = new();
    private bool usualExact = true, advanced, blocksEdited;
    private List<DaySegment> periods = new();
    private List<CalendarEvent> events = new();
    private List<TaskItem> scheduledToday = new();
    private DayPlan? plan;
    private bool loading, busy, addToCalendar, dayOff;

    private List<PeriodBlock> blocks = new();
    private Dictionary<string, PeriodKind> categoryMap = new();
    private string dayOffWords = "";
    private int defaultMinutes, bufferMinutes, autoMax;
    private bool autoEvening, autoMorning, autoCalendar;
    private TimeOnly autoEveningTime, autoMorningTime;

    private static readonly DayOfWeek[] WeekOrder = { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };

    private record TlItem(DateTime Start, DateTime End, string Title, string Meta, string Css, bool IsNow);

    protected override async Task OnInitializedAsync()
    {
        Watch(Tasks.Repo);
        Watch(Schedule.Plans);
        date = Clock.Today;
        if (Tab is "week" or "template") tab = Tab;
        LoadTemplate();
        await LoadDayAsync();
        if (tab == "week") await LoadWeekAsync();
    }

    protected override void OnDataChanged()
    {
        LoadTasks();
        dayPlans = Schedule.PlansOn(date);
        upcoming = Schedule.Upcoming();
    }

    private void LoadTasks() =>
        scheduledToday = Tasks.Open().Where(t => t.ScheduledStart is { } s && DateOnly.FromDateTime(s) == date).OrderBy(t => t.ScheduledStart).ToList();

    private async Task LoadDayAsync(bool bypass = false)
    {
        loading = true;
        try
        {
            events = await Calendar.GetEventsAsync(date, date, bypass);
            periods = Schedule.Periods(date, events);
            dayOff = Schedule.IsDayOff(date, events);
            dayPlans = Schedule.PlansOn(date);
            upcoming = Schedule.Upcoming();
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { loading = false; }
        LoadTasks();
    }

    private Task Reload() => LoadDayAsync(true);

    private async Task Go(int days) => await GoTo(date.AddDays(days));

    private async Task GoTo(DateOnly d)
    {
        date = d;
        plan = null;
        await LoadDayAsync();
    }

    private async Task DatePicked(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d)) await GoTo(d);
    }

    private IEnumerable<TlItem> Timeline()
    {
        var now = Clock.Now;
        var items = new List<TlItem>();
        items.AddRange(periods.Select(p => new TlItem(p.Start, p.End, p.Label, p.Kind.ToString()!, "k-" + p.Kind, p.Start <= now && p.End > now)));
        items.AddRange(events.Where(e => !e.AllDay).Select(e => new TlItem(e.Start, e.End, e.Title, string.Join(" · ", new[] { e.Location, e.Source }.Where(x => !string.IsNullOrEmpty(x))), "event", e.Start <= now && e.End > now)));
        var minutes = Settings.Current.Schedule.DefaultTaskMinutes;
        items.AddRange(scheduledToday.Select(t => new TlItem(t.ScheduledStart!.Value, t.ScheduledStart!.Value.AddMinutes(t.EstimatedMinutes ?? minutes), t.Title, t.Category, "task", false)));
        if (plan is not null)
            items.AddRange(plan.Planned.Select(p => new TlItem(p.Start, p.End, p.Title, $"proposed · {p.Category}", "task proposed", false)));
        return items.OrderBy(i => i.Start).ThenBy(i => i.Css.StartsWith("k-") ? 0 : 1);
    }

    private async Task Propose()
    {
        busy = true;
        try { plan = await Planner.ProposeAsync(date); }
        catch (Exception ex) { Ui.Error(ex); }
        finally { busy = false; }
    }

    private async Task Apply()
    {
        if (plan is null) return;
        busy = true;
        try
        {
            var n = await Planner.ApplyAsync(plan, addToCalendar);
            Ui.Show($"Planned {n} task(s)");
            plan = null;
            await LoadDayAsync(addToCalendar);
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { busy = false; }
    }

    private async Task Unplan(TaskItem t)
    {
        t.ScheduledStart = null;
        await Tasks.SaveAsync(t);
    }

    // ----- time off and plans -----

    private async Task PlansChanged()
    {
        await LoadDayAsync();
        if (tab == "week") await LoadWeekAsync();
    }

    private async Task RemovePlan(SchedulePlan p)
    {
        await Schedule.DeletePlanAsync(p.Id);
        Ui.Show($"Removed {p.Name}");
        await PlansChanged();
    }

    private static string PlanCss(PlanKind k) => k switch { PlanKind.Out => "Out", PlanKind.Reserved => "Reserved", PlanKind.Working => "Work", _ => "Free" };
    private static string PlanBadge(PlanKind k) => k switch { PlanKind.DayOff => "ok", PlanKind.Working => "info", PlanKind.Out => "warn", _ => "" };
    private static string KindLabel(PeriodKind k) => k == PeriodKind.Reserved ? "Keep free" : k.ToString();

    // ----- week -----

    private async Task OpenWeek()
    {
        tab = "week";
        await LoadWeekAsync();
    }

    private async Task MoveWeek(int days)
    {
        weekStart = weekStart.AddDays(days);
        await LoadWeekAsync(keepStart: true);
    }

    private async Task OpenDay(DateOnly d)
    {
        tab = "day";
        await GoTo(d);
    }

    private async Task LoadWeekAsync(bool keepStart = false)
    {
        if (!keepStart) weekStart = date.AddDays(-(((int)date.DayOfWeek + 6) % 7));
        loading = true;
        try
        {
            var all = await Calendar.GetEventsAsync(weekStart, weekStart.AddDays(6));
            var minutes = Settings.Current.Schedule.DefaultTaskMinutes;
            var planned = Tasks.Open().Where(t => t.ScheduledStart is not null).ToList();
            var list = new List<WeekDay>();
            for (var i = 0; i < 7; i++)
            {
                var d = weekStart.AddDays(i);
                var dayEvents = all.Where(e => DateOnly.FromDateTime(e.Start) <= d && (e.AllDay ? DateOnly.FromDateTime(e.End) > d : DateOnly.FromDateTime(e.Start) == d)).ToList();
                var items = new List<(DateTime Start, WeekItem Item)>();
                // Working hours are in the day's summary line; only extra or changed work is listed.
                foreach (var p in Schedule.Periods(d, dayEvents).Where(p => p.Kind is PeriodKind.Out or PeriodKind.Reserved || (p.Kind == PeriodKind.Work && p.Label != "Work")))
                    items.Add((p.Start, new WeekItem($"{p.Start:HH:mm}–{p.End:HH:mm}", p.Label, p.Kind.ToString()!)));
                foreach (var p in Schedule.PlansOn(d).Where(p => p.AllDay && p.Kind == PlanKind.DayOff))
                    items.Add((d.ToDateTime(TimeOnly.MinValue), new WeekItem("all day", p.Name, "Free")));
                foreach (var e in dayEvents)
                    items.Add((e.AllDay ? d.ToDateTime(TimeOnly.MinValue) : e.Start, new WeekItem(e.AllDay ? "all day" : e.Start.ToString("HH:mm"), e.Title, "event")));
                foreach (var t in planned.Where(t => DateOnly.FromDateTime(t.ScheduledStart!.Value) == d))
                    items.Add((t.ScheduledStart!.Value, new WeekItem(t.ScheduledStart!.Value.ToString("HH:mm"), t.Title, "task")));
                list.Add(new WeekDay(d, Schedule.Summary(d, dayEvents), Schedule.IsDayOff(d, dayEvents), items.OrderBy(x => x.Start).Select(x => x.Item).ToList()));
            }
            week = list;
            upcoming = Schedule.Upcoming();
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { loading = false; }
    }

    // ----- usual week -----

    private void LoadTemplate()
    {
        var s = Settings.Current.Schedule;
        blocks = s.Blocks.OrderBy(b => b.Days.Select(d => ((int)d + 6) % 7).DefaultIfEmpty(9).Min()).ThenBy(b => b.Start).ToList();
        if (s.Usual is not null) { usual = Json.Clone(s.Usual); usualExact = true; }
        else usual = UsualWeek.FromBlocks(s.Blocks, out usualExact);
        advanced = false; blocksEdited = false;
        categoryMap = new Dictionary<string, PeriodKind>(s.CategoryPeriods);
        dayOffWords = string.Join(", ", s.DayOffKeywords);
        defaultMinutes = s.DefaultTaskMinutes;
        bufferMinutes = s.BufferMinutes;
        autoEvening = s.AutoPlanEvening; autoEveningTime = s.AutoPlanEveningTime;
        autoMorning = s.AutoPlanMorning; autoMorningTime = s.AutoPlanMorningTime;
        autoCalendar = s.AutoPlanAddToCalendar; autoMax = s.AutoPlanMaxTasks;
    }

    private string FirstWorkDayName => usual.Days.FirstOrDefault(d => d.Working)?.Day.ToString() ?? "Monday";

    private void CopyFirstWorkDay()
    {
        var first = usual.Days.FirstOrDefault(d => d.Working);
        if (first is null) return;
        foreach (var d in usual.Days.Where(d => d.Working)) { d.WorkStart = first.WorkStart; d.WorkEnd = first.WorkEnd; }
    }

    private void AddRegular() => usual.Regular.Add(new RegularTime { Days = new() { DayOfWeek.Monday } });

    private void Edited() => blocksEdited = true;

    private void BackToSimple()
    {
        if (blocksEdited) usual = UsualWeek.FromBlocks(blocks, out usualExact);
        advanced = false;
    }

    private async Task RunAutoPlanNow()
    {
        await SaveTemplate();
        try { Ui.Show(await Automation.RunPlanAsync(Clock.Today.AddDays(1), "Tomorrow", Settings.Current.Schedule)); }
        catch (Exception ex) { Ui.Error(ex); }
    }

    private static void ToggleDay(List<DayOfWeek> days, DayOfWeek d)
    {
        if (!days.Remove(d)) days.Add(d);
    }

    private void AddBlock()
    {
        blocks.Add(new PeriodBlock { Days = UsualWeek.Order.Take(5).ToList(), Start = new(9, 0), End = new(17, 0), Kind = PeriodKind.Work, Label = "Work" });
        blocksEdited = true;
    }

    private async Task SaveTemplate()
    {
        var map = categoryMap.Where(kv => kv.Value != PeriodKind.Free).ToDictionary(kv => kv.Key, kv => kv.Value);
        // The detailed editor wins only when it was used; otherwise the simple settings make the periods.
        var detailed = advanced && blocksEdited;
        var newBlocks = detailed ? blocks : usual.ToBlocks();
        await Settings.UpdateAsync(s =>
        {
            s.Schedule.Usual = detailed ? null : Json.Clone(usual);
            s.Schedule.Blocks = newBlocks;
            s.Schedule.CategoryPeriods = map;
            s.Schedule.DayOffKeywords = dayOffWords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            s.Schedule.DefaultTaskMinutes = Math.Max(5, defaultMinutes);
            s.Schedule.BufferMinutes = Math.Max(0, bufferMinutes);
            s.Schedule.AutoPlanEvening = autoEvening; s.Schedule.AutoPlanEveningTime = autoEveningTime;
            s.Schedule.AutoPlanMorning = autoMorning; s.Schedule.AutoPlanMorningTime = autoMorningTime;
            s.Schedule.AutoPlanAddToCalendar = autoCalendar; s.Schedule.AutoPlanMaxTasks = Math.Clamp(autoMax, 1, 30);
        });
        Ui.Show("Saved");
        LoadTemplate();
        await LoadDayAsync();
    }

    private void ResetTemplate()
    {
        usual = new UsualWeek();
        usualExact = true;
        blocks = usual.ToBlocks();
        advanced = false; blocksEdited = false;
        categoryMap = new() { ["Work"] = PeriodKind.Work };
    }
}
