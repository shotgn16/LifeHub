@page "/"
@inject ModuleRegistry Modules
@inject SettingsService Settings
@inject UserContext User
@inject ScheduleService Schedule
@inject Clock Clock
@inject UiState Ui

<PageTitle>Today · LifeHub</PageTitle>

<div class="page-head">
    <div>
        <h1>@Greeting@(User.Me is { } me && User.Multi ? ", " + me.FirstName : "")</h1>
        <div class="sub">@Clock.Now.ToString("dddd d MMMM", Fmt.Culture)@(period is not null ? $" · {period.Label}" : "")</div>
    </div>
    <div class="actions">
        <button class="btn ghost" @onclick="() => customise = !customise"><Icon Name="settings" Size="15" /> @(customise ? "Done" : "Customise")</button>
        @if (Modules.IsOn("schedule")) { <a class="btn" href="schedule"><Icon Name="wand" Size="15" /> Plan my day</a> }
    </div>
</div>

@if (!Settings.Current.HomeAssistant.Enabled && !Settings.Current.Ollama.Enabled && Settings.Current.Email.Accounts.Count == 0)
{
    <div class="alert info"><Icon Name="sparkles" /> <div>Welcome! Everything works straight away. When you're ready, connect <a href="settings?tab=ai">your AI</a>, <a href="settings?tab=email">email</a> or <a href="settings?tab=ha">Home Assistant</a>, and choose which parts of LifeHub you use in <a href="settings?tab=modules">Settings → Modules</a>.</div></div>
}

@if (customise)
{
    <div class="card" style="margin-bottom:var(--gap)">
        <h2 style="margin-bottom:6px">Your home screen</h2>
        <p class="small muted" style="margin-top:0">Show, hide and reorder the cards. This only changes your home screen.</p>
        <ul class="list">
            @foreach (var m in ordered)
            {
                var hidden = User.Me?.DashboardHidden.Contains(m.Key) == true;
                <li class="row">
                    <Icon Name="@m.Icon" Size="16" />
                    <div class="grow">@m.Title</div>
                    <button class="icon-btn sm" title="Move up" @onclick="() => Move(m.Key, -1)"><Icon Name="up" Size="14" /></button>
                    <button class="icon-btn sm" title="Move down" @onclick="() => Move(m.Key, 1)"><Icon Name="down" Size="14" /></button>
                    <label class="switch"><input type="checkbox" checked="@(!hidden)" @onchange="e => Show(m.Key, (bool)e.Value!)" /></label>
                </li>
            }
        </ul>
    </div>
}

<div class="widget-grid">
    @foreach (var m in Modules.Widgets(User.Me))
    {
        <DynamicComponent Type="m.Widget!" @key="m.Key" />
    }
</div>

@code {
    private CurrentPeriod? period;
    private bool customise;
    private List<LifeHubModule> ordered = new();

    private string Greeting => Clock.Now.Hour >= 18 ? "Good evening" : Clock.Now.Hour >= 12 ? "Good afternoon" : "Good morning";

    protected override async Task OnInitializedAsync()
    {
        Order();
        try { period = await Schedule.CurrentAsync(); } catch { }
    }

    private void Order()
    {
        var me = User.Me;
        var all = Modules.Enabled().Where(m => m.Widget is not null).ToList();
        var order = me?.DashboardOrder ?? new();
        ordered = all.OrderBy(m => order.IndexOf(m.Key) is var i && i >= 0 ? i : 1000 + m.Order).ToList();
    }

    private async Task Move(string key, int by)
    {
        var keys = ordered.Select(m => m.Key).ToList();
        var i = keys.IndexOf(key);
        var j = Math.Clamp(i + by, 0, keys.Count - 1);
        if (i == j) return;
        (keys[i], keys[j]) = (keys[j], keys[i]);
        await Settings.UpdateUserAsync(User.Id, u => u.DashboardOrder = keys);
        Order();
    }

    private async Task Show(string key, bool on)
    {
        await Settings.UpdateUserAsync(User.Id, u =>
        {
            u.DashboardHidden.Remove(key);
            if (!on) u.DashboardHidden.Add(key);
        });
        Order();
    }
}
