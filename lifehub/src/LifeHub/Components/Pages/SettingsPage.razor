@page "/settings"
@inject DataPaths Paths
@inject UserContext User

<PageTitle>Settings · LifeHub</PageTitle>

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <div class="sub">Data folder: <code>@Paths.Root</code>@(Paths.IsHomeAssistantAddon ? " · running as Home Assistant add-on" : "")</div>
    </div>
</div>

<div class="tabs">
    @foreach (var (key, label) in Tabs.Where(t => User.IsAdmin || PersonalTabs.Contains(t.Item1)))
    {
        <a class="tab @(Current == key ? "on" : "")" href="settings?tab=@key" style="text-decoration:none">@label</a>
    }
</div>

@switch (Current)
{
    case "people" when User.IsAdmin: <SettingsPeople /> break;
    case "ha": <SettingsHomeAssistant /> break;
    case "ai" when User.IsAdmin: <SettingsAi /> break;
    case "email": <SettingsEmail /> break;
    case "notifications": <SettingsNotifications /> break;
    case "bible": <SettingsBible /> break;
    case "security": <SettingsSecurity /> break;
    case "backup" when User.IsAdmin: <SettingsBackup /> break;
    case "general" when User.IsAdmin: <SettingsGeneral /> break;
    default:
        if (User.IsAdmin) { <SettingsGeneral /> } else { <SettingsEmail /> }
        break;
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private string Current => Tab ?? (User.IsAdmin ? "general" : "email");
    /// <summary>Tabs everyone sees (their own mailboxes, phones, Bible and sign-in); the rest are for admins.</summary>
    private static readonly HashSet<string> PersonalTabs = new() { "ha", "email", "notifications", "bible", "security" };

    private static readonly (string, string)[] Tabs =
    {
        ("general", "General"), ("people", "People"), ("ha", "Home Assistant"), ("ai", "AI"), ("email", "Email"),
        ("notifications", "Notifications"), ("bible", "Bible"), ("security", "Security & API"), ("backup", "Backup")
    };
}
