<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:src="@mipmap/ic_launcher" android:contentDescription="LifeHub" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="LifeHub" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75"
            android:text="Connect this phone to your own LifeHub. Use the address you open LifeHub on from your phone — e.g. https://lifehub.example.com, or http://192.168.1.10:8099 at home (the add-on's port must be mapped in Home Assistant)." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="LifeHub address" android:textStyle="bold" />
        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://lifehub.example.com" android:inputType="textUri" android:autofillHints="url" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Your API key" android:textStyle="bold" />
        <EditText android:id="@+id/key" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="lh_…" android:inputType="textPassword" android:fontFamily="monospace" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:alpha="0.7" android:textSize="13sp"
            android:text="In LifeHub (in a browser): Settings → Security &amp; API → Your API key → Show → copy. It signs you in as you." />

        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Check &amp; save" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="On this phone" android:textSize="18sp" android:textStyle="bold" />
        <Switch android:id="@+id/notify" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Show LifeHub notifications (checks every 15 minutes)" />
        <Switch android:id="@+id/bible" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Time in the Bible app" />
        <TextView android:id="@+id/bibleStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:alpha="0.75" android:textSize="13sp" />
        <Button android:id="@+id/usageAccess" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Open Usage access" android:visibility="gone" />

        <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Open LifeHub" />
    </LinearLayout>
</ScrollView>
